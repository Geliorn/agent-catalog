{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "agent-catalog/term-links",
	"title": "Каталог: ссылки на термины",
	"category": "widgets",
	"description": "Список ссылок на термины таксономии (темы/теги) с опциональным счётчиком — для навигации в подвале и меню.",
	"attributes": {
		"taxonomy": { "type": "string", "default": "repo_topic" },
		"number": { "type": "number", "default": 8 },
		"showCount": { "type": "boolean", "default": false },
		"orderBy": { "type": "string", "default": "count" }
	},
	"supports": { "html": false },
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
